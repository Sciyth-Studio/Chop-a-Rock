{
  "name": "KarateChop",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/shared",
      "Packages": { "$path": "Packages" },
      "ReplicaClient": { "$path": "vendor/Replica/src/ReplicatedStorage/ReplicaClient.luau" },
      "ReplicaShared": { "$path": "vendor/Replica/src/ReplicatedStorage/ReplicaShared" },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "VFX": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Sounds": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Music": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Animations": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Models": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Images": { "$className": "Folder", "$ignoreUnknownInstances": true }
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/server",
      "ServerPackages": { "$path": "ServerPackages" },
      "ReplicaServer": { "$path": "vendor/Replica/src/ServerScriptService/ReplicaServer.luau" }
    },
    "SoundService": {
      "$ignoreUnknownInstances": true,
      "Music": { "$className": "SoundGroup", "$properties": { "Volume": 1 } },
      "SoundEffects": { "$className": "SoundGroup", "$properties": { "Volume": 1 } }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    }
  }
}
