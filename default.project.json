{
  "name": "KarateChop",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/shared",
      "Packages": { "$path": "Packages" },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "VFX": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Sounds": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Animations": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Models": { "$className": "Folder", "$ignoreUnknownInstances": true },
        "Images": { "$className": "Folder", "$ignoreUnknownInstances": true }
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/server",
      "ServerPackages": { "$path": "ServerPackages" }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    }
  }
}
